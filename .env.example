# Copy this file to .env and fill in your own values.
BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
API_KEY=
LLM_MODEL=your-chat-model
EMBEDDING_MODEL=your-text-embedding-model

# Local Milvus Lite directory; use an HTTP(S) URL for Milvus Server.
MILVUS_URI=data/storage/milvus.db
MILVUS_TOKEN=
MILVUS_COLLECTION=honorguide_chunks

NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# Required for starting local Neo4j from the page. Use your installation paths.
NEO4J_HOME=C:/path/to/neo4j
JAVA_HOME=C:/path/to/jdk-21
